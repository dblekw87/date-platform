# Backend API server used by frontend server routes and server components.
DATE_BACKEND_URL=http://localhost:4010
# Read only when the backend above does not answer. The collector runs on a
# desktop the deployed site cannot reach, so it publishes one rendered board
# here and production falls back to it. Leave unset locally.
DATE_BOARD_SNAPSHOT_URL=https://raw.githubusercontent.com/dblekw87/date-board-snapshot/main/board.json
# Shared with the backend's INTERNAL_JWT_SECRET. Both sides must use the same value.
# The frontend signs a 2-minute token per backend call so the backend can verify the caller.
INTERNAL_JWT_SECRET=

# Frontend auth
# Required in production. The app throws on startup without it.
AUTH_SESSION_SECRET=replace-with-a-long-random-secret
# true enables the /auth/mock login shortcut and the signed-out-by-default mock user.
# Keep false outside local development.
DATE_MOCK_AUTH=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
NAVER_OAUTH_CLIENT_ID=
NAVER_OAUTH_CLIENT_SECRET=
KAKAO_REST_API_KEY=
KAKAO_OAUTH_CLIENT_SECRET=

# SEC EDGAR does not need an API key, but requests should identify the app and contact.
SEC_USER_AGENT="DATE Market Board your-email@example.com"

# Optional normalized news feed. If present, the app will normalize it into the News tab.
MARKET_BOARD_NEWS_FEED_URL=

# News providers
NAVER_API_HUB_KEY_ID=
NAVER_API_HUB_KEY=
NAVER_PAPAGO_CLIENT_ID=
NAVER_PAPAGO_CLIENT_SECRET=
NEWSAPI_KEY=
FINNHUB_API_KEY=
BENZINGA_API_KEY=

# Market data provider secrets belong in date-platform-backend.
# The frontend reads normalized market-board data through DATE_BACKEND_URL.
KRX_API_KEY=
DART_API_KEY=

# Optional macro data providers
BLS_API_KEY=
FRED_API_KEY=

# 절대 URL이 필요한 곳(OG 카드, 정규 주소, robots, sitemap)이 쓰는 사이트 주소.
# 비워 두면 Vercel이 넣어 주는 운영 도메인을, 그것도 없으면 기본값을 씁니다.
NEXT_PUBLIC_SITE_URL=
